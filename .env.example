# Imprint Labs Video Gen Tool — environment variables
# Copy this to .env and fill in your keys

# Required for AI script writing (get at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: photo sources (falls back to Wikimedia Commons if absent)
PEXELS_API_KEY=...
UNSPLASH_ACCESS_KEY=...

# Optional: YouTube transcript fetching for research
# No key needed — youtube-transcript-api uses public captions

# Optional: override the Claude model used for scripting
# ANTHROPIC_MODEL=claude-sonnet-4-6
